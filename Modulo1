    // Quiz Correction
    function correctQuiz() {
      const answers = {
        q1: 'b',
        q2: 'a',
        q3: 'c',
        q4: 'a'
      };

      let score = 0;
      let allAnswered = true;

      for (let i = 1; i <= 4; i++) {
        const selected = document.querySelector(`input[name="q${i}"]:checked`);
        const box = document.getElementById(`q${i}-box`);
        if (!selected) {
          allAnswered = false;
          if (box) box.classList.add('border-amber-400');
          continue;
        }

        if (box) box.classList.remove('border-amber-400', 'border-emerald-500', 'border-red-400');

        if (selected.value === answers[`q${i}`]) {
          score++;
          if (box) box.classList.add('border-emerald-500', 'bg-emerald-50/20');
        } else {
          if (box) box.classList.add('border-red-400', 'bg-red-50/20');
        }
      }

      const resultBox = document.getElementById('quizResult');
      if (!allAnswered) {
        resultBox.className = 'p-5 rounded-2xl border text-sm space-y-2 block bg-amber-50 border-amber-300 text-amber-900';
        resultBox.innerHTML = `<strong>Atenção:</strong> Responda todas as 4 questões antes de submeter.`;
        return;
      }

      resultBox.classList.remove('hidden');
      state.score = score;
      state.quizCompleted = true;

      if (score >= 3) {
        resultBox.className = 'p-5 rounded-2xl border text-sm space-y-2 block bg-emerald-50 border-emerald-300 text-emerald-900';
        resultBox.innerHTML = `
          <div class="flex items-center space-x-2 font-bold text-base">
            <i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>
            <span>Parabéns! Você acertou ${score} de 4 questões!</span>
          </div>
          <p>Você demonstrou domínio dos conceitos essenciais do Debian. O Módulo 1 está concluído com sucesso e você está pronto para o Módulo 2 (SSH)!</p>
        `;
      } else {
        resultBox.className = 'p-5 rounded-2xl border text-sm space-y-2 block bg-red-50 border-red-300 text-red-900';
        resultBox.innerHTML = `
          <div class="flex items-center space-x-2 font-bold text-base">
            <i class="fa-solid fa-circle-xmark text-red-600 text-lg"></i>
            <span>Você acertou ${score} de 4 questões.</span>
          </div>
          <p>Revise os cards do Dicionário Técnico na Unidade 6 e tente novamente para fixar os conceitos!</p>
        `;
      }

      saveState();
      updateProgress();
    }

    // YouTube URL Extractor & Updater
    function extractYoutubeId(urlOrId) {
      if (!urlOrId) return '';
      const clean = urlOrId.trim();
      if (/^[a-zA-Z0-9_-]{11}$/.test(clean)) {
        return clean;
      }
      const shortMatch = clean.match(/youtu\.be\/([a-zA-Z0-9_-]{11})/);
      if (shortMatch) return shortMatch[1];
      const match = clean.match(/(?:v=|\/embed\/|\/live\/|\/v\/)([a-zA-Z0-9_-]{11})/);
      if (match) return match[1];
      return '';
    }

    function updateYoutubeVideo() {
      const input = document.getElementById('customYoutubeInput');
      if (!input) return;
      const val = input.value.trim();
      const videoId = extractYoutubeId(val);

      if (!videoId) {
        showToast('Link do YouTube inválido. Cole a URL completa ou o ID do vídeo.');
        return;
      }

      const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`;
      const ytPlayer = document.getElementById('youtubePlayer');
      if (ytPlayer) ytPlayer.src = embedUrl;

      const directLink = document.getElementById('directYoutubeLink');
      if (directLink) {
        directLink.href = `https://www.youtube.com/watch?v=${videoId}`;
        directLink.innerText = `https://youtu.be/${videoId}`;
      }

      try {
        localStorage.setItem('modulo1_youtube_videoid', videoId);
      } catch (e) {}

      showToast('Vídeo do YouTube atualizado com sucesso!');
    }

    function loadSavedYoutubeVideo() {
      try {
        const saved = localStorage.getItem('modulo1_youtube_videoid');
        if (saved) {
          const embedUrl = `https://www.youtube-nocookie.com/embed/${saved}?rel=0`;
          const ytPlayer = document.getElementById('youtubePlayer');
          if (ytPlayer) ytPlayer.src = embedUrl;
          const directLink = document.getElementById('directYoutubeLink');
          if (directLink) {
            directLink.href = `https://www.youtube.com/watch?v=${saved}`;
            directLink.innerText = `https://youtu.be/${saved}`;
          }
          const ytInput = document.getElementById('customYoutubeInput');
          if (ytInput) ytInput.value = `https://youtu.be/${saved}`;
        }
      } catch (e) {}
    }

    // Initialize on load
    window.onload = function() {
      loadSavedState();
      loadSavedYoutubeVideo();
      updateProgress();

      const termInput = document.getElementById('termInput');
      if (termInput) {
        termInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            const val = this.value;
            if (val.trim() !== '') {
              runSimCommand(val);
              this.value = '';
            }
          }
        });
      }
    };
  </script>
</body>
</html>

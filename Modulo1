                <button onclick="copyToClipboard('auto lo\niface lo inet loopback\n\n# Interface Agrupada em Modo Redundante (Bonding)\nauto bond0\niface bond0 inet static\n    address 192.168.10.10/24\n    gateway 192.168.10.1\n    dns-nameservers 1.1.1.1 8.8.8.8\n    bond-slaves enp0s3 enp0s8\n    bond-mode active-backup\n    bond-miimon 100\n    bond-primary enp0s3')" class="absolute top-2.5 right-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 px-2 py-0.5 rounded text-[10px] font-sans">Copiar Bloco</button>
                <pre># Interface Local
auto lo
iface lo inet loopback

# Interface Agrupada em Modo Redundante (Bonding)
auto bond0
iface bond0 inet static
    address 192.168.10.10/24
    gateway 192.168.10.1
    dns-nameservers 1.1.1.1 8.8.8.8
    bond-slaves enp0s3 enp0s8
    bond-mode active-backup
    bond-miimon 100
    bond-primary enp0s3</pre>

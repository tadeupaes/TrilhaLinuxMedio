  <!-- Notification Toast for Copying -->
  <div id="toast" class="fixed bottom-6 right-6 bg-slate-900 text-white px-4 py-2.5 rounded-xl shadow-xl text-xs flex items-center space-x-2 opacity-0 pointer-events-none transition-all duration-300 z-50">
    <i class="fa-solid fa-check text-emerald-400"></i>
    <span id="toastMsg">Comando copiado para a área de transferência!</span>
  </div>

  <script>
    // Module Progress State (SCORM-like LocalStorage)
    const state = {
      visitedUnits: new Set(['unit1']),
      quizCompleted: false,
      score: 0
    };

    // Show Toast Notification
    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      if (!toast || !toastMsg) return;
      toastMsg.innerText = message;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      toast.classList.add('opacity-100');
      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2500);
    }

    // Copy to Clipboard Fallback
    function copyToClipboard(text) {
      if (!text) return;
      const tempInput = document.createElement('textarea');
      tempInput.value = text;
      document.body.appendChild(tempInput);
      tempInput.select();
      try {
        document.execCommand('copy');
        showToast('Comando copiado para a área de transferência!');
      } catch (err) {
        showToast('Não foi possível copiar automaticamente.');
      }
      document.body.removeChild(tempInput);
    }

    // Switch Tabs / SCORM Units
    function switchTab(unitId) {
      const sections = document.querySelectorAll('.tab-content');
      sections.forEach(sec => sec.classList.remove('active'));

      const target = document.getElementById(unitId);
      if (target) {
        target.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      const navButtons = document.querySelectorAll('.step-btn');
      navButtons.forEach(btn => {
        btn.classList.remove('bg-white', 'text-debian', 'border-pink-200', 'shadow-sm');
        btn.classList.add('text-slate-600');
        const badge = btn.querySelector('span:first-child');
        if (badge) {
          badge.classList.remove('bg-debian', 'text-white');
          badge.classList.add('bg-slate-300', 'text-slate-700');
        }
      });

      const activeBtn = document.getElementById('nav-' + unitId);
      if (activeBtn) {
        activeBtn.classList.remove('text-slate-600');
        activeBtn.classList.add('bg-white', 'text-debian', 'border', 'border-pink-200', 'shadow-sm');
        const badge = activeBtn.querySelector('span:first-child');
        if (badge) {
          badge.classList.remove('bg-slate-300', 'text-slate-700');
          badge.classList.add('bg-debian', 'text-white');
        }
      }

      state.visitedUnits.add(unitId);
      saveState();
      updateProgress();
    }

    function updateProgress() {
      const totalSteps = 8;
      if (state.quizCompleted && !state.visitedUnits.has('unit7')) {
        state.visitedUnits.add('unit7');
      }
      const percent = Math.min(Math.round((state.visitedUnits.size / totalSteps) * 100), 100);
      const progressBar = document.getElementById('progressBar');
      const progressText = document.getElementById('progressText');
      if (progressBar) progressBar.style.width = percent + '%';
      if (progressText) progressText.innerText = percent + '% Concluído';
    }

    function saveState() {
      try {
        localStorage.setItem('modulo1_visited', JSON.stringify(Array.from(state.visitedUnits)));
        localStorage.setItem('modulo1_quiz', JSON.stringify({ completed: state.quizCompleted, score: state.score }));
      } catch (e) {}
    }

    function loadSavedState() {
      try {
        const visited = localStorage.getItem('modulo1_visited');
        if (visited) {
          const arr = JSON.parse(visited);
          if (Array.isArray(arr)) {
            arr.forEach(u => state.visitedUnits.add(u));
          }
        }
        const quiz = localStorage.getItem('modulo1_quiz');
        if (quiz) {
          const parsed = JSON.parse(quiz);
          state.quizCompleted = parsed.completed || false;
          state.score = parsed.score || 0;
        }
      } catch (e) {}
    }

    function resetProgress() {
      state.visitedUnits = new Set(['unit1']);
      state.quizCompleted = false;
      state.score = 0;
      try {
        localStorage.removeItem('modulo1_visited');
        localStorage.removeItem('modulo1_quiz');
      } catch (e) {}
      switchTab('unit1');
      showToast('Progresso reiniciado com sucesso!');
    }

    // Terminal Simulator Execution
    function appendTerminalOutput(cmd, outputHtml) {
      const screen = document.getElementById('terminalScreen');
      if (!screen) return;

      const isRoot = currentPromptMode === 'root';
      const promptText = isRoot ? 'root@debian:~#' : 'aluno@debian:~$';
      const promptColor = isRoot ? 'text-red-400' : 'text-terminal-prompt';

      const cmdLine = document.createElement('div');
      cmdLine.innerHTML = `<span class="${promptColor} font-bold">${promptText}</span> <span class="text-white">${escapeHtml(cmd)}</span>`;
      screen.appendChild(cmdLine);

      if (outputHtml) {
        const outDiv = document.createElement('div');
        outDiv.className = 'text-slate-300 text-xs py-1 whitespace-pre-wrap';
        outDiv.innerHTML = outputHtml;
        screen.appendChild(outDiv);
      }

      screen.scrollTop = screen.scrollHeight;
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.innerText = text;
      return div.innerHTML;
    }

    let currentPromptMode = 'aluno';

    function setPromptMode(mode) {
      currentPromptMode = mode;
      const indicator = document.getElementById('promptIndicator');
      if (indicator) {
        if (mode === 'root') {
          indicator.innerText = 'root@debian:~#';
          indicator.className = 'text-red-400 font-mono-code font-bold text-xs sm:text-sm shrink-0';
        } else {
          indicator.innerText = 'aluno@debian:~$';
          indicator.className = 'text-terminal-prompt font-mono-code font-bold text-xs sm:text-sm shrink-0';
        }
      }
    }

    function executeQuick(cmd) {
      runSimCommand(cmd);
    }

    function submitTermInput() {
      const termInput = document.getElementById('termInput');
      if (!termInput) return;
      const val = termInput.value;
      if (val.trim() !== '') {
        runSimCommand(val);
        termInput.value = '';
      }
    }

    function runSimCommand(cmd) {
      const trimmed = cmd.trim();
      const screen = document.getElementById('terminalScreen');
      if (!screen) return;

      if (trimmed.toLowerCase() === 'clear') {
        screen.innerHTML = `
          <div class="text-slate-400">Debian GNU/Linux 12 (bookworm) - Terminal de Aprendizado Interativo.</div>
          <div class="text-slate-400">Digite <span class="text-terminal-text font-bold">help</span> para listar os comandos aceitos.</div>
        `;
        return;
      }

      if (trimmed.toLowerCase() === 'help') {
        const helpText = `Comandos interativos simulados disponíveis:
  <span class="text-terminal-prompt">whoami</span>                   : Exibe o usuário atual logado
  <span class="text-terminal-prompt">id</span>                       : Exibe UID, GID e grupos da conta
  <span class="text-terminal-prompt">sudo -l</span>                  : Lista permissões permitidas com sudo
  <span class="text-terminal-prompt">su -</span>                     : Alterna para a sessão do superusuário root
  <span class="text-terminal-prompt">exit</span>                     : Sai do modo root ou encerra sessão
  <span class="text-terminal-prompt">sudo apt update</span>         : Baixa o índice atualizado dos repositórios
  <span class="text-terminal-prompt">sudo apt upgrade -y</span>      : Atualiza os pacotes instalados
  <span class="text-terminal-prompt">apt show nginx</span>           : Exibe metadados, versão e descrição do pacote
  <span class="text-terminal-prompt">apt policy nginx</span>         : Mostra a origem e prioridade do repositório
  <span class="text-terminal-prompt">apt depends nginx</span>        : Lista as dependências do software
  <span class="text-terminal-prompt">apt list --installed</span>    : Lista softwares instalados no sistema
  <span class="text-terminal-prompt">ip -br link</span>              : Status resumido das placas de rede físicas
  <span class="text-terminal-prompt">ip addr show</span>             : Lista endereços IP e sub-redes ativas
  <span class="text-terminal-prompt">ip route</span>                 : Exibe a tabela de rotas e o gateway padrão
  <span class="text-terminal-prompt">ping -c 3 1.1.1.1</span>        : Envia 3 pacotes de teste para a Internet
  <span class="text-terminal-prompt">getent hosts debian.org</span>  : Testa a resolução de nomes (DNS)
  <span class="text-terminal-prompt">cat /proc/net/bonding/bond0</span>: Inspeciona o estado da agregação e placa ativa
  <span class="text-terminal-prompt">clear</span>                    : Limpa a tela do terminal`;
        appendTerminalOutput(cmd, helpText);
        return;
      }

      // Identidade e Permissões
      if (trimmed === 'whoami') {
        appendTerminalOutput(cmd, currentPromptMode === 'root' ? 'root' : 'aluno');
        return;
      }

      if (trimmed === 'id' || trimmed === 'id aluno') {
        const out = currentPromptMode === 'root'
          ? `uid=0(root) gid=0(root) grupos=0(root)`
          : `uid=1000(aluno) gid=1000(aluno) grupos=1000(aluno),27(sudo),1001(ti)`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed === 'sudo -l') {
        const out = `Matching Defaults entries for aluno on debian-srv:
    env_reset, mail_badpass, secure_path=/usr/local/sbin\\:/usr/local/bin\\:/usr/sbin\\:/usr/bin\\:/sbin\\:/bin

User aluno may run the following commands on debian-srv:
    <span class="text-emerald-400 font-bold">(ALL : ALL) ALL</span>`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed === 'su -') {
        setPromptMode('root');
        appendTerminalOutput(cmd, `<span class="text-slate-400">Password: [senha verificada]</span>
<span class="text-red-400 font-bold">root@debian:~#</span> Sessão de superusuário iniciada com sucesso. Variáveis e /sbin carregados.`);
        return;
      }

      if (trimmed === 'exit') {
        if (currentPromptMode === 'root') {
          setPromptMode('aluno');
          appendTerminalOutput(cmd, `<span class="text-slate-400">logout</span>
Retornando à conta padrão (aluno).`);
        } else {
          appendTerminalOutput(cmd, `<span class="text-slate-400">logout (sessão mantida para continuidade da aula).</span>`);
        }
        return;
      }

      // APT e Pacotes
      if (trimmed === 'sudo apt update' || trimmed === 'apt update') {
        const out = `Hit:1 http://deb.debian.org/debian bookworm InRelease
Get:2 http://security.debian.org/debian-security bookworm-security InRelease [48.0 kB]
Get:3 http://deb.debian.org/debian bookworm-updates InRelease [55.4 kB]
Fetched 103 kB in 1s (98.2 kB/s)
Reading package lists... Done
Building dependency tree... Done
<span class="text-emerald-400 font-bold">All packages are up to date.</span>`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed.startsWith('sudo apt upgrade') || trimmed.startsWith('apt upgrade')) {
        const out = `Reading package lists... Done
Building dependency tree... Done
Reading state information... Done
Calculating upgrade... Done
0 upgraded, 0 newly installed, 0 to remove and 0 not upgraded.
<span class="text-emerald-400">O sistema já está com as versões mais seguras e recentes.</span>`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed === 'apt show nginx') {
        const out = `Package: nginx
Version: 1.22.1-9
Priority: optional
Section: httpd
Maintainer: Debian Nginx Maintainers &lt;pkg-nginx-maintainers@alioth-lists.debian.net&gt;
Installed-Size: 1,385 kB
Depends: libc6 (&gt;= 2.34), libcrypt1, libpcre2-8-0, libssl3, zlib1g, nginx-common
Homepage: https://nginx.org
Description: small, powerful, scalable web/proxy server
 Nginx is a web server designed for high performance, high concurrency
 and low memory usage.`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed === 'apt policy nginx') {
        const out = `nginx:
  Installed: (none)
  Candidate: 1.22.1-9
  Version table:
     1.22.1-9 500
        500 http://deb.debian.org/debian bookworm/main amd64 Packages`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed === 'apt depends nginx') {
        const out = `nginx
  Depends: libc6 (&gt;= 2.34)
  Depends: libcrypt1 (&gt;= 1:4.1.0)
  Depends: libpcre2-8-0 (&gt;= 10.22)
  Depends: libssl3 (&gt;= 3.0.0)
  Depends: zlib1g (&gt;= 1:1.1.4)
  Depends: nginx-common (= 1.22.1-9)
  Suggests: nginx-doc`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed === 'apt list --installed') {
        const out = `Listing... Done
base-files/stable,now 12.4+deb12u5 amd64 [installed]
bash/stable,now 5.2.15-2+b2 amd64 [installed]
curl/stable,now 7.88.1-10+deb12u5 amd64 [installed]
iproute2/stable,now 6.1.0-3 amd64 [installed]
sudo/stable,now 1.9.13p3-1+deb12u1 amd64 [installed]
systemd/stable,now 252.22-1~deb12u1 amd64 [installed]
... [245 pacotes essenciais ativos no Debian Server]`;
        appendTerminalOutput(cmd, out);
        return;
      }

      // Rede e Bonding
      if (trimmed === 'ip -br link') {
        const out = `lo               UNKNOWN        00:00:00:00:00:00 &lt;LOOPBACK,UP,LOWER_UP&gt; 
enp0s3           UP             08:00:27:3e:bc:12 &lt;BROADCAST,MULTICAST,SLAVE,UP,LOWER_UP&gt; 
enp0s8           UP             08:00:27:fa:19:80 &lt;BROADCAST,MULTICAST,SLAVE,UP,LOWER_UP&gt; 
bond0            UP             08:00:27:3e:bc:12 &lt;BROADCAST,MULTICAST,MASTER,UP,LOWER_UP&gt;`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed === 'ip addr show' || trimmed === 'ip a' || trimmed === 'ip addr') {
        const out = `1: lo: &lt;LOOPBACK,UP,LOWER_UP&gt; mtu 65536 qdisc noqueue state UNKNOWN group default qlen 1000
    inet 127.0.0.1/8 scope host lo
2: enp0s3: &lt;BROADCAST,MULTICAST,SLAVE,UP,LOWER_UP&gt; mtu 1500 master bond0 state UP
3: enp0s8: &lt;BROADCAST,MULTICAST,SLAVE,UP,LOWER_UP&gt; mtu 1500 master bond0 state UP
4: bond0: &lt;BROADCAST,MULTICAST,MASTER,UP,LOWER_UP&gt; mtu 1500 qdisc noqueue state UP
    inet <span class="text-pink-400 font-bold">192.168.10.10/24</span> brd 192.168.10.255 scope global bond0
       valid_lft forever preferred_lft forever`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed === 'ip route' || trimmed === 'ip r') {
        const out = `<span class="text-emerald-400 font-bold">default via 192.168.10.1 dev bond0 onlink</span> 
192.168.10.0/24 dev bond0 proto kernel scope link src 192.168.10.10`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed.startsWith('ping -c 3')) {
        const target = trimmed.split(' ')[3] || '1.1.1.1';
        const out = `PING ${target} (${target}) 56(84) bytes of data.
64 bytes from ${target}: icmp_seq=1 ttl=57 time=12.4 ms
64 bytes from ${target}: icmp_seq=2 ttl=57 time=11.8 ms
64 bytes from ${target}: icmp_seq=3 ttl=57 time=12.1 ms

--- ${target} ping statistics ---
3 packets transmitted, <span class="text-emerald-400 font-bold">3 received, 0% packet loss</span>, time 2003ms
rtt min/avg/max/mdev = 11.812/12.104/12.421/0.250 ms`;
        appendTerminalOutput(cmd, out);
        return;
      }

      if (trimmed.startsWith('getent hosts')) {
        const host = trimmed.split(' ')[2] || 'debian.org';
        const out = `151.101.194.132  ${host}
151.101.66.132   ${host}
<span class="text-emerald-400">[OK] Resolução DNS concluída com sucesso via servidores em /etc/resolv.conf.</span>`;
